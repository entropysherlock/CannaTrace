DATABASE_URL="postgresql://cannatrace:cannatrace@localhost:5432/cannatrace"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: secret for the scheduled sync route (/api/sync/run). Generate like AUTH_SECRET.
CRON_SECRET=""

# Optional: Metrc. Leave empty to use practice mode or hand entry.
# METRC_API_URL is your state's address, for example https://api-mi.metrc.com
METRC_API_URL=""
METRC_VENDOR_KEY=""
METRC_USER_KEY=""

# Required to let businesses connect their own Claude account to Tally: 32 random bytes as base64
# (the Support console's Tally key storage box can generate one). Redeploy after changing it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and never change it without setting the old value as AI_KEY_ENCRYPTION_KEY_PREVIOUS.
AI_KEY_ENCRYPTION_KEY=
# CannaTrace's own Claude key. Used ONLY for the live demo, for organization ids listed in TALLY_PLATFORM_ORGS,
# and locally when TALLY_DEV_USE_PLATFORM_KEY=1. Customers' Tally runs on their own connected keys.
ANTHROPIC_API_KEY=
TALLY_PLATFORM_ORGS=

# Invite-only access (src/lib/access.ts). With nothing set, only the built-in founder emails can sign in,
# sign-up is closed, and the live demo is off.
# ALLOWED_SIGNIN_EMAILS=you@example.com,partner@example.com
# SIGNUPS_OPEN=true
# LIVE_DEMO=on
# For automated tests and local development only, never production: lift the lock entirely.
OPEN_ACCESS=1
# Local tests create many businesses, which all count toward the hourly sign-up limit (default 20). CI lifts it the same way.
# Never set this in production.
SIGNUPS_PER_HOUR=1000
